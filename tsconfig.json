{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2021"
    ],
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": [
      "./.millennium/types",
      "./node_modules/@types"
    ],
    "paths": {
      "millennium": [
        "./.millennium/lsp/ts"
      ]
    }
  },
  "include": [
    "frontend/**/*",
    "shared/**/*",
    ".generated/**/*",
    ".millennium/types/**/*.d.ts"
  ],
  "exclude": [
    "webview"
  ]
}